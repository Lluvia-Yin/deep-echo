function handleScreenClick(cx, cy) {
  if (S.state !== 'playing') return;
  if (scriptedCamera || S.waitingForChoice) return;
  ndc.x = (cx / W()) * 2 - 1;
  ndc.y = -(cy / H()) * 2 + 1;
  raycaster.setFromCamera(ndc, camera);
  if (S.abyssMode) {
    const cores = ABYSS_LIGHTS.filter(l => !l.userData.lit).map(l => l.userData.core);
    if (cores.length > 0) {
      const hits = raycaster.intersectObjects(cores, false);
      if (hits.length > 0) {
        const lg = ABYSS_LIGHTS.find(l => l.userData.core === hits[0].object);
        if (lg) { uiClick(); tapLabel(lg.userData.labelEl); lightAbyssPoint(lg); return; }
      }
    }
    return;
  }
  if (hotspotMarkers.length > 0) {
    const cores = hotspotMarkers.map(h => h.marker.userData.core);
    const hits = raycaster.intersectObjects(cores, false);
    if (hits.length > 0) {
      const hm = hotspotMarkers.find(h => h.marker.userData.core === hits[0].object);
      if (hm) {
        if (!hm.alwaysVisible) {
          const pp = new THREE.Vector3(basePos.x, 1.7, basePos.z);
          if (pp.distanceTo(hm.marker.position) > VISIBLE_RANGE) return;
        }
        uiClick();
        tapLabel(hm.label);
        if (timedChoice) { timedChoice.cleanup(); timedChoice = null; }
        handleHotspotClick(hm.data);
        return;
      }
    }
  }
  if (itemMarkers.length > 0) {
    const allCores = [];
    const map = [];
    for (const im of itemMarkers) {
      if (im.isInteractive) {
        im.marker.traverse(o => { if (o.isMesh) { allCores.push(o); map.push(im); } });
      } else {
        allCores.push(im.marker.userData.core);
        map.push(im);
      }
    }
    const hits = raycaster.intersectObjects(allCores, false);
    if (hits.length > 0) {
      const hitObj = hits[0].object;
      const im = map[allCores.indexOf(hitObj)];
      if (im) {
        const pp = new THREE.Vector3(basePos.x, 1.7, basePos.z);
        if (pp.distanceTo(im.marker.position) > VISIBLE_RANGE) return;
