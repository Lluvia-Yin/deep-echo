function evalCondition(cond) {
  if (!cond) return true;
  if (cond === 'trust<0') return S.trust < 0;
  if (cond === 'trust>=0') return S.trust >= 0;
  if (cond === 'trust<-1') return S.trust < -1;
  if (cond === 'hasAllMems') return S.memories.length >= MEM_TOTAL;
  if (cond === 'o2Low') return S.oxygen < 30;
  if (cond === 'echoHigh') return S.echo > 60;
  if (cond.startsWith('visited:')) return !!S.visitedHotspots[cond.slice(8)];
  // 结局回响：mem:<id> —— 是否收集过该段记忆
  if (cond.startsWith('mem:')) return !!S.collected[cond.slice(4)];
  // 跨房间谜题：flag:<name> —— 是否拿到过某条线索
  if (cond.startsWith('flag:')) return !!S.flags[cond.slice(5)];
  // 笔记成为条件：note:<kw> —— 笔记本里是否写下过某关键词（支持 | 分隔多个关键词）
  if (cond.startsWith('note:')) {
    const kws = cond.slice(5).toLowerCase().split('|');
    return S.notes.some(n => kws.some(kw => kw && (n.text || '').toLowerCase().indexOf(kw) >= 0));
  }
  // 结局残响继承：replay —— 是否解锁过任意结局（二周目及以后）
  if (cond === 'replay') return Object.keys(S.unlockedEndings).length > 0;
  return true;
}
