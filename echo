@keyframes slideIn{from{opacity:0;transform:translateX(-16px);}to{opacity:1;transform:none;}}
.mem-card .mh{font-size:11px;letter-spacing:.34em;color:#4dd0e1;opacity:.85;margin-bottom:12px;}
.mem-card .mt{font-size:15px;line-height:2;color:#cfe6f3;white-space:pre-line;}
.mem-card .mf{margin-top:14px;font-size:11.5px;color:#6a8ba0;letter-spacing:.1em;font-style:italic;}
.log-card{background:rgba(6,16,30,.6);border-left:2px solid rgba(77,208,225,.35);border-radius:6px;padding:14px 20px;}
.log-card.speaker-deepsea{border-left-color:#4dd0e1;}
.log-card.speaker-you{border-left-color:#ffb86b;}
.log-card.speaker-sys{border-left-color:#7a9cb0;}
.log-card.speaker-echo{border-left-color:#c9a8ff;}
.log-card .who{font-size:11px;letter-spacing:.24em;color:#6a8ba0;margin-bottom:6px;}
.log-card.speaker-deepsea .who{color:#4dd0e1;}
.log-card.speaker-you .who{color:#ffb86b;}
.log-card.speaker-echo .who{color:#c9a8ff;}
.log-card .what{font-size:14px;line-height:1.85;color:#cfe6f3;}
.mem-empty{text-align:center;color:#4a6a80;font-size:13px;letter-spacing:.2em;padding:80px 0;}
#notebook-panel .notebook-body{flex:1;overflow-y:auto;padding:30px 40px 60px;
  max-width:820px;width:100%;margin:0 auto;display:flex;flex-direction:column;gap:16px;}
#notebook-panel .notebook-hint{font-size:12px;letter-spacing:.1em;color:#7a9cb0;line-height:1.9;
  padding:14px 18px;background:rgba(30,20,6,.4);border-left:2px solid rgba(255,209,102,.4);border-radius:6px;}
#notebook-panel .notebook-hint em{color:#ffd166;font-style:normal;}
#notebook-panel .notebook-input-wrap{display:flex;gap:10px;}
#notebook-panel #notebook-input{flex:1;background:rgba(6,18,34,.9);
  border:1px solid rgba(255,209,102,.3);border-radius:8px;padding:13px 18px;
  color:#fff;font-size:14px;font-family:inherit;letter-spacing:.04em;outline:none;transition:all .2s;pointer-events:auto;}
#notebook-panel #notebook-input:focus{border-color:#ffd166;box-shadow:0 0 20px rgba(255,209,102,.35);}
#notebook-panel #notebook-input::placeholder{color:#5a7090;font-style:italic;}
#notebook-panel #notebook-add{font-family:inherit;font-size:11px;letter-spacing:.3em;
  color:#ffd166;background:rgba(255,209,102,.1);border:1px solid rgba(255,209,102,.4);
  border-radius:8px;padding:13px 24px;cursor:pointer;transition:all .22s;}
#notebook-panel #notebook-add:hover:not(:disabled){color:#1a1208;background:#ffd166;border-color:#ffd166;box-shadow:0 0 26px rgba(255,209,102,.7);}
#notebook-panel #notebook-add:disabled{opacity:.35;cursor:not-allowed;}
#notebook-panel .notebook-remaining{font-size:10.5px;letter-spacing:.24em;color:#7a9cb0;text-align:right;}
#notebook-panel .notebook-remaining.warn{color:#ffb86b;}
#notebook-panel .notebook-list{display:flex;flex-direction:column;gap:12px;margin-top:8px;}
.note-item{background:linear-gradient(150deg,rgba(30,20,6,.7),rgba(12,8,4,.8));
  border:1px solid rgba(255,209,102,.2);border-left:3px solid #ffd166;
  border-radius:10px;padding:16px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;
  animation:noteIn .45s cubic-bezier(.2,1,.4,1) both;}
@keyframes noteIn{from{opacity:0;transform:translateX(-12px);}to{opacity:1;transform:none;}}
.note-item .note-text{font-size:14.5px;line-height:1.7;color:#ffd9a8;letter-spacing:.03em;font-style:italic;flex:1;}
.note-item .note-text::before{content:'「';color:#ffd166;margin-right:2px;}
.note-item .note-text::after{content:'」';color:#ffd166;margin-left:2px;}
.note-item .note-meta{font-size:10px;letter-spacing:.2em;color:#7a9cb0;margin-top:6px;}
.note-item .note-del{font-family:inherit;font-size:10px;letter-spacing:.24em;
  color:#7a9cb0;background:transparent;border:1px solid rgba(122,156,176,.3);border-radius:6px;
  padding:7px 12px;cursor:pointer;transition:all .2s;flex:0 0 auto;}
.note-item .note-del:hover{color:#ff8a8a;border-color:#ff8a8a;box-shadow:0 0 18px rgba(255,138,138,.35);}
.notebook-empty{text-align:center;color:#4a6a80;font-size:13px;letter-spacing:.2em;padding:60px 0;}
.ending-card{background:linear-gradient(150deg,rgba(20,10,40,.7),rgba(8,4,22,.85));
  border:1px solid rgba(200,140,255,.22);border-left:3px solid #c9a8ff;
  border-radius:12px;padding:22px 26px;animation:slideIn .5s cubic-bezier(.2,1,.4,1) both;}
.ending-card.true{background:linear-gradient(150deg,rgba(30,15,60,.8),rgba(10,4,28,.9));
  border-left-color:#fff;box-shadow:0 0 30px rgba(200,140,255,.25);}
.ending-card.locked{background:linear-gradient(150deg,rgba(10,10,14,.6),rgba(4,4,8,.7));
  border:1px solid rgba(122,156,176,.14);border-left:3px solid rgba(122,156,176,.25);
  opacity:.65;filter:grayscale(.8);}
.ending-card.locked .ec-title{color:#5a7090;text-shadow:none;}
.ending-card.locked .ec-rank{color:#5a7090;text-shadow:none;}
.ending-card .ec-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;}
.ending-card .ec-title{font-size:19px;font-weight:400;letter-spacing:.3em;color:#eafcff;text-shadow:0 0 18px rgba(200,140,255,.5);}
.ending-card.true .ec-title{background:linear-gradient(180deg,#fff,#c9a8ff);
  -webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 14px rgba(200,140,255,.8));}
.ending-card .ec-rank{font-size:22px;font-weight:700;color:#fff;
  text-shadow:0 0 18px rgba(200,140,255,.7);font-variant-numeric:tabular-nums;}
.ending-card.true .ec-rank{color:#ffd166;text-shadow:0 0 22px rgba(255,209,102,.8);}
.ending-card .ec-sub{font-size:10.5px;letter-spacing:.32em;color:#7a9cb0;margin-bottom:14px;}
.ending-card .ec-stats{display:flex;gap:22px;flex-wrap:wrap;
  padding:12px 0;border-top:1px solid rgba(200,140,255,.14);
  border-bottom:1px solid rgba(200,140,255,.14);margin-bottom:14px;}
.ending-card .ec-stats .s{display:flex;flex-direction:column;gap:3px;}
.ending-card .ec-stats .s .v{font-size:14px;font-weight:700;color:#eafcff;font-variant-numeric:tabular-nums;letter-spacing:.04em;}
.ending-card .ec-stats .s .k{font-size:9px;letter-spacing:.3em;color:#7a9cb0;}
.ending-card .ec-notes-label{font-size:10px;letter-spacing:.32em;color:#ffd166;margin-bottom:8px;}
.ending-card .ec-notes{display:flex;flex-direction:column;gap:6px;}
.ending-card .ec-notes .n{font-size:13px;line-height:1.7;color:#ffd9a8;font-style:italic;
  letter-spacing:.02em;padding-left:12px;position:relative;}
.ending-card .ec-notes .n::before{content:'·';position:absolute;left:0;color:#ffd166;font-style:normal;}
.ending-card .ec-no-notes{font-size:12px;color:#4a6a80;font-style:italic;}
#mobile-pad{position:absolute;bottom:34px;left:24px;z-index:10;display:none;
  grid-template-columns:repeat(3,54px);grid-template-rows:repeat(3,54px);gap:6px;opacity:0;transition:opacity .6s;}
#mobile-pad.on{opacity:.85;}
#mobile-pad .btn{width:54px;height:54px;border-radius:50%;background:rgba(6,26,44,.75);
  border:1px solid rgba(77,208,225,.35);color:#7feaff;font-size:18px;
  display:flex;align-items:center;justify-content:center;pointer-events:auto;cursor:pointer;
  text-shadow:0 0 10px rgba(77,208,225,.7);transition:all .12s;}
#mobile-pad .btn:active,#mobile-pad .btn.down{background:rgba(77,208,225,.3);border-color:#4dd0e1;transform:scale(.94);}
#mobile-pad .empty{visibility:hidden;}
@media (max-width:900px){#mobile-pad{display:grid;}}
@media (hover:none){#mobile-pad{display:grid;}}
#overlay{position:absolute;inset:0;z-index:30;display:flex;align-items:center;justify-content:center;
  background:rgba(2,6,14,.93);transition:opacity .8s ease;cursor:pointer;overflow-y:auto;}
#overlay.hidden{opacity:0;pointer-events:none;}
#overlay .inner{text-align:center;max-width:740px;padding:60px 30px;animation:fadeUp 1.1s cubic-bezier(.2,1,.4,1) both;}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:none;}}
#overlay h1{font-size:clamp(34px,7.5vw,68px);font-weight:200;letter-spacing:.42em;text-indent:.42em;
  background:linear-gradient(180deg,#eafcff 5%,#4dd0e1 60%,#1a6e88 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 34px rgba(77,208,225,.45));line-height:1.2;}
#overlay .en{font-size:clamp(11px,1.8vw,14px);letter-spacing:.9em;text-indent:.9em;color:#3d7f96;margin-top:10px;}
#overlay .desc{margin-top:36px;font-size:14px;line-height:2.05;color:#8fb4c8;letter-spacing:.08em;}
#overlay .desc b{color:#7fe9ff;font-weight:500;}
#overlay .desc em{color:#ffb86b;font-style:normal;}
#overlay .start-hint{margin-top:46px;font-size:11.5px;letter-spacing:.55em;color:#4dd0e1;animation:pulse 2s ease-in-out infinite;}
#overlay .credit{margin-top:30px;font-size:10px;letter-spacing:.3em;color:#2e4d5e;}
.menu-btns{margin-top:40px;display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
.menu-btn{font-size:12px;letter-spacing:.4em;color:#4dd0e1;border:1px solid rgba(77,208,225,.4);
  border-radius:8px;padding:13px 30px;cursor:pointer;transition:all .25s;background:transparent;font-family:inherit;}
.menu-btn:hover{color:#fff;border-color:#4dd0e1;box-shadow:0 0 30px rgba(77,208,225,.5);}
.menu-btn.primary{background:rgba(77,208,225,.1);}
.menu-btn.endings{color:#c9a8ff;border-color:rgba(200,140,255,.4);}
.menu-btn.endings:hover{color:#fff;border-color:#c9a8ff;box-shadow:0 0 30px rgba(200,140,255,.5);}
.menu-btn.lang{color:#ffd166;border-color:rgba(255,209,102,.4);}
.menu-btn.lang:hover{color:#fff;border-color:#ffd166;box-shadow:0 0 30px rgba(255,209,102,.5);}
.difficulty-row{margin-top:30px;display:flex;flex-direction:column;gap:12px;align-items:center;
  padding:20px 0;border-top:1px solid rgba(77,208,225,.12);border-bottom:1px solid rgba(77,208,225,.12);}
.difficulty-label{font-size:10px;letter-spacing:.4em;color:#7fd8ee;opacity:.7;text-shadow:0 0 10px rgba(34,230,255,.5);}
.difficulty-opts{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}
.diff-opt{font-size:11px;letter-spacing:.32em;color:#7a9cb0;
  border:1px solid rgba(122,156,176,.3);border-radius:8px;padding:10px 22px;
  cursor:pointer;transition:all .22s;font-family:inherit;background:transparent;}
.diff-opt:hover{color:#fff;border-color:#7a9cb0;}
.diff-opt.active{color:#fff;border-color:#4dd0e1;background:rgba(77,208,225,.12);
  box-shadow:0 0 20px rgba(77,208,225,.4);text-shadow:0 0 12px rgba(77,208,225,.7);}
.diff-hint{margin-top:8px;font-size:10px;letter-spacing:.22em;color:#3d7f96;opacity:.7;}
#overlay .ending-title{font-size:clamp(26px,5vw,44px);font-weight:200;letter-spacing:.5em;text-indent:.5em;
  color:#eafcff;text-shadow:0 0 40px rgba(77,208,225,.5);}
#overlay .ending-title.hidden-title{color:#ffbccb;text-shadow:0 0 44px rgba(255,90,122,.6);}
#overlay .ending-title.true-ending{background:linear-gradient(180deg,#fff 0%,#c9a8ff 40%,#4dd0e1 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 44px rgba(200,140,255,.85));font-size:clamp(30px,6vw,56px);font-weight:300;}
#overlay .ending-sub{margin-top:22px;font-size:12px;letter-spacing:.6em;text-indent:.6em;color:#3d7f96;}
#overlay .ending-sub.true-sub{color:#c9a8ff;text-shadow:0 0 16px rgba(200,140,255,.6);}
#overlay .ending-text{margin-top:40px;font-size:15px;line-height:2.2;color:#9ec4d6;letter-spacing:.06em;}
#overlay .ending-text .name{color:#fff;text-shadow:0 0 24px rgba(200,140,255,1),0 0 48px rgba(127,233,255,.6);
  letter-spacing:.18em;font-weight:500;}
.ending-stats{margin-top:34px;display:flex;gap:26px;justify-content:center;flex-wrap:wrap;
  padding:20px 24px;border-top:1px solid rgba(77,208,225,.15);border-bottom:1px solid rgba(77,208,225,.15);}
.stat-block{text-align:center;min-width:80px;}
.stat-block .v{font-size:22px;font-weight:700;color:#fff;line-height:1;
  text-shadow:0 0 18px rgba(77,208,225,.6);font-variant-numeric:tabular-nums;}
.stat-block .k{font-size:9.5px;letter-spacing:.34em;color:#7fd8ee;opacity:.7;margin-top:6px;}
.ending-restart{margin-top:42px;display:inline-block;font-size:11px;letter-spacing:.4em;
  color:#4dd0e1;border:1px solid rgba(77,208,225,.35);border-radius:8px;padding:13px 30px;transition:all .25s;cursor:pointer;margin-right:10px;}
.ending-restart:hover{color:#fff;border-color:#4dd0e1;box-shadow:0 0 30px rgba(77,208,225,.5);}
.ending-restart.secondary{color:#7a9cb0;border-color:rgba(122,156,176,.35);}
.ending-restart.secondary:hover{color:#fff;border-color:#7a9cb0;box-shadow:0 0 30px rgba(122,156,176,.4);}
.signature{margin-top:34px;padding-top:24px;border-top:1px solid rgba(200,140,255,.2);
  font-size:11px;letter-spacing:.42em;color:#c9a8ff;text-shadow:0 0 14px rgba(200,140,255,.6);
  animation:sigFade 2.4s ease-in .8s both;}
.signature .big{display:block;font-size:14px;letter-spacing:.34em;margin-bottom:8px;color:#fff;
  text-shadow:0 0 22px rgba(200,140,255,.9);}
@keyframes sigFade{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}
#fade{position:absolute;inset:0;z-index:25;background:#02060e;opacity:0;pointer-events:none;transition:opacity .7s ease;}
#fade.on{opacity:1;}
#water-screen{position:fixed;inset:0;z-index:26;pointer-events:none;opacity:0;transition:opacity 1.4s ease;
  background:radial-gradient(ellipse at 50% 55%,rgba(120,220,255,.4) 0%,rgba(20,80,140,.85) 40%,rgba(0,8,22,.98) 90%);}
#water-screen.on{opacity:1;}
#loading-flag{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  z-index:28;font-size:11px;letter-spacing:.5em;color:#4dd0e1;opacity:0;transition:opacity .3s;pointer-events:none;}
#loading-flag.on{opacity:.8;animation:pulse 1.4s ease-in-out infinite;}
#abyss-hint{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  z-index:8;pointer-events:none;text-align:center;opacity:0;transition:opacity 1s;}
#abyss-hint.on{opacity:.9;}
#abyss-hint .txt{font-size:14px;letter-spacing:.5em;color:#9fefff;
  text-shadow:0 0 24px rgba(159,239,255,.8),0 0 48px rgba(159,239,255,.4);}
#abyss-hint .num{font-size:38px;font-weight:200;margin-top:14px;color:#fff;
  text-shadow:0 0 30px rgba(159,239,255,.9);font-variant-numeric:tabular-nums;letter-spacing:.1em;}
@media (max-width:600px){
  #scene-title{top:16px;font-size:11px;letter-spacing:.28em;}
  #top-btns{right:14px;top:14px;gap:6px;}
  #minimap{right:14px;top:60px;width:140px;height:105px;}
  .icon-btn .cnt{padding:6px 10px;font-size:10px;}
  #text-box{padding:18px 20px 24px;}
  #text-panel{bottom:22px;width:92vw;}
  .panel-head{padding:18px 22px;}
  .panel-list{padding:22px 20px 40px;}
  #notebook-panel .notebook-body{padding:20px 22px 40px;}
  .hud-left{left:16px;top:16px;width:min(180px,50vw);}
  .explore{left:16px;bottom:16px;}
  #scan-info{right:14px;width:min(260px,70vw);}
  #radio-hud{right:14px;top:calc(50% + 100px);}
  #notebook-btn{right:14px;bottom:14px;}
  #notebook-btn .cnt{padding:6px 10px;font-size:10px;}
  #choice-btns{right:14px;bottom:calc(22px + 150px);}
  .c-btn{font-size:11px;padding:11px 20px;min-width:100px;}
}
</style>
