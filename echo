function loadSave() {
  try { const raw = localStorage.getItem(SAVE_KEY); if (!raw) return null;
    const d = JSON.parse(raw); if (!d || !d.nodeId || !STORY[d.nodeId]) return null; return d; }
  catch (e) { return null; }
}
function loadCheckpoint() {
  try { const raw = localStorage.getItem(SAVE_KEY + '_checkpoint'); if (!raw) return null;
    const d = JSON.parse(raw); if (!d || !d.nodeId || !STORY[d.nodeId]) return null; return d; }
