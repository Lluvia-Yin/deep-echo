const SAVE_KEY = 'echo3d_save_v14';
function autoSave() {
  try {
    const data = {
      nodeId: S.nodeId, memories: S.memories, collected: S.collected,
      visitedHotspots: S.visitedHotspots, trust: S.trust,
      history: S.history.slice(-80),
      oxygen: S.oxygen, echo: S.echo, explored: S.explored,
      lowO2Blessing: S.lowO2Blessing, difficulty: S.difficulty,
      respondedCount: S.respondedCount, silentCount: S.silentCount,
      visitedRooms: S.visitedRooms,
