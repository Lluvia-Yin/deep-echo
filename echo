function makeDust(w, h, d, count = 180, color = 0x6ad8ee) {
  const geo = new THREE.BufferGeometry();
  const pos = new Float32Array(count * 3);
  const vel = new Float32Array(count * 3);
  for (let i = 0; i < count; i++) {
    pos[i*3] = rand(-w/2 + 0.5, w/2 - 0.5);
    pos[i*3+1] = rand(0.3, h - 0.3);
    pos[i*3+2] = rand(-d/2 + 0.5, d/2 - 0.5);
    vel[i*3] = rand(-0.05, 0.05); vel[i*3+1] = rand(0.008, 0.04); vel[i*3+2] = rand(-0.05, 0.05);
  }
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  const p = new THREE.Points(geo, new THREE.PointsMaterial({
    color, size: 0.035, transparent: true, opacity: 0.5,
    blending: THREE.AdditiveBlending, depthWrite: false, sizeAttenuation: true }));
  p.userData = { vel, count, h, w, d };
  return p;
}
function updateDust(dust, dt) {
  if (!dust) return;
  const arr = dust.geometry.attributes.position.array;
  const vel = dust.userData.vel;
  const { count, h, w, d } = dust.userData;
  const hw = w/2, hd = d/2;
  for (let i = 0; i < count; i++) {
    const ix = i*3;
    arr[ix] += vel[ix]*dt; arr[ix+1] += vel[ix+1]*dt; arr[ix+2] += vel[ix+2]*dt;
    if (arr[ix+1] > h-0.2) arr[ix+1] = 0.3;
    if (arr[ix] < -hw) { arr[ix] = -hw; vel[ix] = Math.abs(vel[ix]); }
    if (arr[ix] > hw) { arr[ix] = hw; vel[ix] = -Math.abs(vel[ix]); }
    if (arr[ix+2] < -hd) { arr[ix+2] = -hd; vel[ix+2] = Math.abs(vel[ix+2]); }
    if (arr[ix+2] > hd) { arr[ix+2] = hd; vel[ix+2] = -Math.abs(vel[ix+2]); }
  }
  dust.geometry.attributes.position.needsUpdate = true;
}
