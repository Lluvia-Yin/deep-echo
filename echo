      lang: S0.lang, time: Date.now(),
    };
    localStorage.setItem(SAVE_KEY, JSON.stringify(data));
    const ck = ['meet_deepsea', 'corridor', 'control_room', 'quarters', 'lab', 'observation', 'truth', 'final_choice'];
    if (ck.includes(S.nodeId)) localStorage.setItem(SAVE_KEY + '_checkpoint', JSON.stringify(data));
