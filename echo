.panel-close:hover{color:#fff;border-color:#4dd0e1;box-shadow:0 0 20px rgba(77,208,225,.4);}
.panel-list{flex:1;overflow-y:auto;padding:34px 40px 60px;display:flex;flex-direction:column;gap:18px;
