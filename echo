function initThree() {
  const canvas = $('bg');
  // 使用后处理时最终画面由全屏 ShaderPass 绘制，默认帧缓冲的 MSAA 无效且额外占显存
  const hasComposer = typeof THREE.EffectComposer !== 'undefined';
  renderer = new THREE.WebGLRenderer({ canvas, antialias: !hasComposer, powerPreference: 'high-performance' });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, MAX_DPR));
  renderer.setSize(W(), H());
