    if (o.material) {
      const mats = Array.isArray(o.material) ? o.material : [o.material];
      // MAT.* 是全局共享材质，销毁后再次进入场景会导致重复重上传
      for (const m of mats) if (m && !SHARED_MATS.has(m)) m.dispose();
    }
  });
}
