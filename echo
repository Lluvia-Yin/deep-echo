<body>
<canvas id="bg"></canvas>
<div id="vignette"></div>
<div id="scanlines"></div>
<div id="glitch"></div>
<div id="pulse"></div>
<div id="heartbeat"></div>
<div id="echo-phase"></div>
<div id="boundary-warning"></div>
<div id="water-screen"></div>
<div id="labels"></div>
<div id="hud">
  <div class="hud-left">
    <div class="res-bar-wrap">
      <div class="res-label"><span id="lbl-o2">O₂ 氧气</span><span class="v" id="o2Val">150%</span></div>
      <div class="res-bar o2" id="o2Bar"><i id="o2Fill"></i></div>
    </div>
    <div class="res-bar-wrap">
      <div class="res-label"><span id="lbl-echo">ECHO 共鸣</span><span class="v" id="echoVal">0%</span></div>
      <div class="res-bar echo" id="echoBar"><i id="echoFill"></i></div>
    </div>
    <div class="steady-btn" id="btn-steady"><span id="lbl-steady">屏 息 · STEADY</span></div>
  </div>
  <div class="explore">
    <div><span id="lbl-explore">探索度</span> <b id="exploreVal">0/0</b><span class="explore-ring" id="exploreRing"></span></div>
    <div class="nearby-line" id="nearbyLine"><span id="lbl-nearby">附近</span> <b id="nearbyCount">0</b> <span id="lbl-nearby-suffix">个可交互点</span></div>
  </div>
</div>
<div id="scene-title"></div>
<div id="hint-move"></div>
<div id="loading-flag"></div>
<div id="abyss-hint">
  <div class="txt" id="lbl-abyss-hint">点 亮 每 一 个 光 点</div>
  <div class="num" id="abyssNum">0 / 12</div>
</div>
<div id="text-panel">
  <div id="text-box">
    <div id="speaker"></div>
    <div id="text-content"></div>
    <div id="text-hint"></div>
  </div>
</div>
<div id="choice-btns">
  <button class="c-btn respond" id="btn-respond"><span id="lbl-respond">回 应</span><span class="hint-sub" id="lbl-respond-sub">O₂ -1 · ECHO -1</span></button>
  <button class="c-btn silent" id="btn-silent"><span id="lbl-silent">沉 默</span><span class="hint-sub" id="lbl-silent-sub">ECHO +2</span></button>
</div>
<div id="scan-info">
  <div class="title" id="scanTitle">S C A N</div>
  <div class="body" id="scanBody"></div>
</div>
<div id="radio-hud">
  <div class="rh-label">RADIO · FM</div>
  <div class="rh-freq" id="radioFreq">87.5</div>
</div>
<div id="top-btns">
  <div class="icon-btn backlog" id="backlog-btn"><div class="ico"></div><div class="cnt" id="lbl-backlog">记 录</div></div>
  <div class="icon-btn" id="memory-btn"><div class="ico"></div><div class="cnt" id="memCount">记忆 0</div></div>
  <div class="icon-btn" id="lang-btn"><div class="cnt" id="langLabel">EN</div></div>
