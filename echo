  if (IS_MOBILE) { try { if (AC.createStereoPanner) return AC.createStereoPanner(); } catch (e) {} return null; }
  try {
    const p = AC.createPanner();
    p.panningModel = 'HRTF'; p.distanceModel = 'inverse';
    p.refDistance = 1.5; p.maxDistance = 40; p.rolloffFactor = 1.4;
    p.coneInnerAngle = 360; p.coneOuterAngle = 360; p.coneOuterGain = 1.0;
    return p;
  } catch (e) { return null; }
}
function updateListener() {
  if (!AC) return;
  const l = AC.listener;
  if (l.positionX) {
    l.positionX.value = basePos.x; l.positionY.value = 1.7; l.positionZ.value = basePos.z;
    const fx = -Math.sin(yaw), fz = -Math.cos(yaw);
    l.forwardX.value = fx; l.forwardY.value = 0; l.forwardZ.value = fz;
    l.upX.value = 0; l.upY.value = 1; l.upZ.value = 0;
  } else if (l.setPosition) {
    l.setPosition(basePos.x, 1.7, basePos.z);
    l.setOrientation(-Math.sin(yaw), 0, -Math.cos(yaw), 0, 1, 0);
  }
}
function playSpatial(freq, dur, type, vol, slideTo, x, y, z) {
  if (!AC || AC.state === 'suspended') return;
  const panner = createPanner();
  if (!panner) { playPooled(freq, dur, type, vol, slideTo); return; }
  updateListener();
  try {
    if (panner.positionX) { panner.positionX.value = x; panner.positionY.value = y; panner.positionZ.value = z; }
    else if (panner.setPosition) panner.setPosition(x, y, z);
    else if (panner.pan !== undefined) {
      const dx = x - basePos.x, dz = z - basePos.z;
      const rx = Math.cos(yaw), rz = -Math.sin(yaw);
      const dot = dx * rx + dz * rz;
      const dist = Math.max(0.5, Math.sqrt(dx*dx + dz*dz));
      panner.pan.value = clamp(dot / dist, -1, 1);
    }
  } catch (e) {}
  const now = AC.currentTime;
  const o = AC.createOscillator(); const g = AC.createGain();
  o.type = type;
  o.frequency.setValueAtTime(freq, now);
  if (slideTo) o.frequency.exponentialRampToValueAtTime(Math.max(20, slideTo), now + dur);
  g.gain.setValueAtTime(0.0001, now);
  g.gain.exponentialRampToValueAtTime(vol, now + 0.012);
  g.gain.exponentialRampToValueAtTime(0.0001, now + dur);
  o.connect(g); g.connect(panner); panner.connect(AC.destination);
  o.start(now); o.stop(now + dur + 0.04);
  setTimeout(() => { try { o.disconnect(); g.disconnect(); panner.disconnect(); } catch (e) {} }, (dur + 0.2) * 1000);
}
function getDeepseaSpeakerPos() {
  const fx = -Math.sin(yaw), fz = -Math.cos(yaw);
  return { x: basePos.x + fx * 4, y: 2.5, z: basePos.z + fz * 4 };
}
function getEchoSourcePos() {
  if (S.nodeId === 'observation' || S.nodeId === 'truth' || S.nodeId === 'final_choice') return { x: 0, y: 2.6, z: -6.94 };
  if (S.abyssMode) return { x: 0, y: 3, z: -18 };
  return { x: 0, y: 3, z: -10 };
}
function startAmbient() {
  if (!AC || ambientOn) return;
  ambientOn = true;
  const o1 = AC.createOscillator(); const o2 = AC.createOscillator();
  const o3 = AC.createOscillator(); const g = AC.createGain();
  const lfo = AC.createOscillator(); const lfoGain = AC.createGain();
  o1.type = 'sine'; o1.frequency.value = 48;
  o2.type = 'sine'; o2.frequency.value = 72.5;
  o3.type = 'triangle'; o3.frequency.value = 96;
  lfo.type = 'sine'; lfo.frequency.value = 0.08;
  lfoGain.gain.value = 0.012;
  const g3 = AC.createGain(); g3.gain.value = 0.3;
  g.gain.value = 0.026;
  lfo.connect(lfoGain); lfoGain.connect(g.gain);
  o1.connect(g); o2.connect(g); o3.connect(g3); g3.connect(g);
  g.connect(AC.destination);
  o1.start(); o2.start(); o3.start(); lfo.start();
  ambientGain = g;
}
function duckAmbient(duck, time = 0.6) {
  if (!ambientGain || !AC) return;
  const t = AC.currentTime;
  const target = duck ? 0.008 : 0.026;
  ambientGain.gain.cancelScheduledValues(t);
  ambientGain.gain.setValueAtTime(ambientGain.gain.value, t);
  ambientGain.gain.linearRampToValueAtTime(target, t + time);
}
function echoSfx() {
