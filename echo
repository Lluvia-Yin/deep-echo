          w.triggered = true; w.active = true; w.t = 0;
          w.group.visible = true; w.bgDisc.visible = false;
          playSpatial(48, 3.5, 'sine', 0.10, 30, 0, 2.6, -11);
          playSpatial(120, 2.5, 'sine', 0.05, 60, 0, 2.6, -11);
          triggerPulse(1400);
        }
      }
      if (w && w.active) {
        w.t += dt;
        const DUR = 2.5;
        const p = w.t / DUR;
        if (p >= 1) { w.active = false; w.group.visible = false; w.bgDisc.visible = true; }
        else {
          w.group.position.x = -30 + p * 60;
          w.group.position.y = 2.6 + Math.sin(p * Math.PI) * 0.5;
          if (w.tailPivot) w.tailPivot.rotation.y = Math.sin(w.t * 8) * 0.6;
          w.group.rotation.z = Math.sin(w.t * 1.5) * 0.05;
        }
      }
    }
  };
};

