function triggerEnding() {
  S.state = 'ending';
  clearHotspotMarkers(); clearItemMarkers(); hideChoiceButtons();
  if (timedChoice) { timedChoice.cleanup(); timedChoice = null; }
  if (S.abyssMode) { cleanupAbyssScene(); S.abyssMode = false; }
  UI.textPanel.classList.remove('on'); UI.sceneTitle.classList.remove('on');
  UI.hintMove.classList.remove('on'); UI.mobilePad.classList.remove('on');
  UI.hud.classList.remove('on'); UI.notebookBtn.classList.remove('on');
  UI.radioHud.classList.remove('on'); UI.minimap.classList.remove('on');
  const ending = S.node.ending;
  bassHit();
  if (ending.hidden) { triggerPulse(4000); setTimeout(echoSfx, 300); }
  let rank = 'C';
  const er = S.totalItems > 0 ? S.explored / S.totalItems : 0;
  const o2r = S.oxygen / S.maxOxygen;
  // 评级纳入 ECHO：共鸣越低（心境越稳）得分越高
  const calm = 1 - clamp(S.echo / S.maxEcho, 0, 1);
  const score = er * 0.5 + o2r * 0.3 + calm * 0.2;
  if (ending.trueEnding) rank = 'S+';
  else if (score >= 0.75) rank = 'S';
  else if (score >= 0.55) rank = 'A';
  else if (score >= 0.35) rank = 'B';
  saveEndingToCollection(ending, rank, o2r);
  clearSave();
  setTimeout(() => {
    UI.overlay.classList.remove('hidden');
    let tc = '';
    if (ending.hidden) tc = 'hidden-title';
    if (ending.trueEnding) tc = 'true-ending';
    let sc = ending.trueEnding ? 'true-sub' : '';
    let sigBlock = '';
    if (ending.trueEnding) {
      sigBlock = `<div class="signature"><span class="big">${L('signature1')}</span><br>${L('signature2')}</div>`;
    }
    const title = S0.lang === 'en' ? (ending.titleEn || ending.title) : ending.title;
    const text = S0.lang === 'en' ? (ending.textEn || ending.text) : ending.text;
    UI.overlay.innerHTML = `
      <div class="inner">
        <div class="ending-title ${tc}">${title}</div>
        <div class="ending-sub ${sc}">${ending.sub}</div>
        <div class="ending-text">${text.replace(/\n/g,'<br>')}</div>
        <div class="ending-stats">
          <div class="stat-block"><div class="v">${rank}</div><div class="k">${L('statRank')}</div></div>
          <div class="stat-block"><div class="v">${S.explored}/${S.totalItems}</div><div class="k">${L('statExplorePoints')}</div></div>
          <div class="stat-block"><div class="v">${Math.round(S.echo)}%</div><div class="k">${L('statEchoPeak')}</div></div>
          <div class="stat-block"><div class="v">${Math.round(o2r*100)}%</div><div class="k">${L('statO2Left')}</div></div>
          <div class="stat-block"><div class="v">${S.memories.length}/${MEM_TOTAL}</div><div class="k">${L('statMemoryShards')}</div></div>
          <div class="stat-block"><div class="v">${S.respondedCount}</div><div class="k">${L('statRespond')}</div></div>
          <div class="stat-block"><div class="v">${S.silentCount}</div><div class="k">${L('statSilent')}</div></div>
          <div class="stat-block"><div class="v">${S.notes.length}</div><div class="k">${L('statNotebook')}</div></div>
        </div>
        ${sigBlock}
        <div class="menu-btns"><div class="ending-restart" id="btnRestart">${L('restart')}</div></div>
      </div>`;
    const btn = $('btnRestart');
    if (btn) btn.onclick = (e) => { e.stopPropagation(); restartAll(); };
  }, 2400);
}
