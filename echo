<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover">
<title>深海回响 · Deep Echo</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;height:100%;overflow:hidden;background:#02060e;
  font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;
  color:#c8e4f5;user-select:none;-webkit-tap-highlight-color:transparent;touch-action:none;}
#bg{position:absolute;inset:0;display:block;}
#vignette{position:absolute;inset:0;pointer-events:none;z-index:2;
  background:radial-gradient(ellipse at 50% 45%,rgba(0,0,0,0) 30%,rgba(0,0,0,.78) 100%);}
#scanlines{position:absolute;inset:0;pointer-events:none;z-index:3;opacity:.11;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,0) 0px,rgba(0,0,0,0) 2px,rgba(0,0,0,.6) 3px,rgba(0,0,0,0) 4px);
  mix-blend-mode:overlay;}
#glitch{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;transition:opacity .12s;}
#glitch.on{opacity:1;animation:glitchShift .14s steps(2) infinite;}
@keyframes glitchShift{
  0%{background:repeating-linear-gradient(0deg,transparent 0,transparent 3px,rgba(255,40,120,.10) 3px,rgba(255,40,120,.10) 5px);transform:translate(0);}
  25%{transform:translate(-3px,2px);}
  50%{background:repeating-linear-gradient(0deg,transparent 0,transparent 5px,rgba(40,240,255,.10) 5px,rgba(40,240,255,.10) 7px);transform:translate(3px,-2px);}
  75%{transform:translate(-2px,0);}
  100%{transform:translate(0);}
}
#pulse{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;transition:opacity .3s;
  background:radial-gradient(ellipse at center,transparent 40%,rgba(255,40,90,.35) 100%);}
#pulse.on{opacity:1;animation:pulseBreath 1.2s ease-in-out infinite;}
@keyframes pulseBreath{0%,100%{opacity:.15;}50%{opacity:.6;}}
#boundary-warning{position:absolute;inset:0;z-index:4;pointer-events:none;
  background:radial-gradient(ellipse at 50% 50%,transparent 55%,rgba(120,60,0,.5) 100%);
  opacity:0;transition:opacity .25s ease;}
#boundary-warning.on{opacity:1;}
#heartbeat{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;transition:opacity .8s;
  background:radial-gradient(ellipse at 50% 50%,transparent 55%,rgba(200,140,255,.25) 100%);}
#heartbeat.on{opacity:1;animation:heartbeat 1.05s ease-in-out infinite;}
@keyframes heartbeat{0%{transform:scale(1);opacity:.35;}14%{transform:scale(1.012);opacity:.85;}
  28%{transform:scale(1);opacity:.35;}42%{transform:scale(1.008);opacity:.7;}
  70%{transform:scale(1);opacity:.35;}100%{transform:scale(1);opacity:.35;}}
/* ECHO 阶段叠加层 */
#echo-phase{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;transition:opacity 1.5s ease;}
#echo-phase.p1{opacity:.35;background:radial-gradient(ellipse at 50% 50%,transparent 45%,rgba(140,80,255,.3) 100%);}
#echo-phase.p2{opacity:.55;background:radial-gradient(ellipse at 50% 50%,transparent 35%,rgba(160,90,255,.45) 100%);}
#echo-phase.p3{opacity:.75;background:radial-gradient(ellipse at 50% 50%,transparent 25%,rgba(180,70,220,.55) 100%);animation:echoPhasePulse 2s ease-in-out infinite;}
@keyframes echoPhasePulse{0%,100%{opacity:.55;}50%{opacity:.9;}}
#hud{position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;transition:opacity .5s;}
#hud.on{opacity:1;}
.hud-left{position:absolute;left:26px;top:24px;display:flex;flex-direction:column;gap:12px;width:min(240px,38vw);}
.res-bar-wrap{position:relative;}
.res-label{display:flex;justify-content:space-between;align-items:baseline;
  font-size:10px;letter-spacing:.3em;color:#7fd8ee;opacity:.8;margin-bottom:5px;
  text-shadow:0 0 10px rgba(34,230,255,.5);}
.res-label .v{font-variant-numeric:tabular-nums;font-weight:700;letter-spacing:.05em;font-size:11px;}
.res-bar{height:8px;border-radius:4px;background:rgba(255,255,255,.07);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.09);overflow:hidden;}
.res-bar i{display:block;height:100%;width:100%;border-radius:4px;
  transition:width .2s linear;transform-origin:left center;}
.res-bar.o2 i{background:linear-gradient(90deg,#22e6ff,#7cf9ff);box-shadow:0 0 14px #22e6ff;}
.res-bar.echo i{background:linear-gradient(270deg,#8a3fff,#c9a8ff);box-shadow:0 0 14px #8a3fff;
  margin-left:auto;transform-origin:right center;}
.res-bar.o2.low i{background:linear-gradient(90deg,#ff2e63,#ff8a5c);box-shadow:0 0 14px #ff2e63;animation:barPulse 1s ease-in-out infinite;}
.res-bar.echo.high i{background:linear-gradient(270deg,#ff5a7a,#c9a8ff);box-shadow:0 0 18px #ff5a7a;animation:barPulse 1.2s ease-in-out infinite;}
@keyframes barPulse{0%,100%{filter:brightness(1);}50%{filter:brightness(1.6);}}
/* 屏息收敛：主动压制 ECHO 的按键/点按控件 */
.steady-btn{margin-top:2px;padding:6px 0;text-align:center;font-size:10px;letter-spacing:.26em;
  color:#9fe8ff;border:1px solid rgba(124,249,255,.28);border-radius:4px;background:rgba(6,26,44,.5);
  pointer-events:auto;cursor:pointer;user-select:none;-webkit-user-select:none;transition:all .15s;}
.steady-btn:hover{border-color:rgba(124,249,255,.6);color:#d6f7ff;}
.steady-btn.down{background:rgba(124,249,255,.22);border-color:#7cf9ff;color:#fff;
  box-shadow:0 0 16px rgba(124,249,255,.5);text-shadow:0 0 12px rgba(124,249,255,.9);}
.steady-btn.blocked{opacity:.3;cursor:default;}
/* 点击反馈：光点回弹 + 标签边框扩散 */
@keyframes tapDot{0%{transform:scale(1);}45%{transform:scale(1.9);}100%{transform:scale(1);}}
@keyframes tapFlash{0%{box-shadow:0 0 0 0 rgba(124,249,255,.6);}100%{box-shadow:0 0 0 12px rgba(124,249,255,0);}}
.hotspot-label.tap .dot,.item-label.tap .dot{animation:tapDot .27s cubic-bezier(.3,1.5,.5,1);}
.hotspot-label.tap .lbl,.item-label.tap .lbl,.abyss-light-label.tap .lbl{animation:tapFlash .32s ease-out;}
/* ECHO 越过临界：数值抖动告警 */
@keyframes txtJit{0%,100%{transform:translate(0,0);}25%{transform:translate(-.5px,.5px);}50%{transform:translate(.5px,-.4px);}75%{transform:translate(-.4px,-.5px);}}
#echoVal.jitter{display:inline-block;animation:txtJit .16s linear infinite;color:#ff9ab0;text-shadow:0 0 12px rgba(255,90,122,.85);}
/* 探索度环形点阵 */
.explore-ring{position:relative;display:inline-block;width:24px;height:24px;vertical-align:-7px;margin-left:7px;}
.explore-ring i{position:absolute;width:3px;height:3px;border-radius:50%;background:rgba(120,180,210,.25);
  transform:translate(-50%,-50%);transition:background .35s ease,box-shadow .35s ease;}
.explore-ring i.on{background:#7cf9ff;box-shadow:0 0 7px rgba(124,249,255,.9);}
.explore{position:absolute;left:26px;bottom:24px;font-size:10px;letter-spacing:.3em;color:#7fd8ee;opacity:.75;
  text-shadow:0 0 10px rgba(34,230,255,.5);display:flex;flex-direction:column;gap:6px;}
.explore b{color:#fff;font-weight:700;letter-spacing:.05em;font-size:12px;}
.explore .nearby-line{color:#ffb86b;text-shadow:0 0 10px rgba(255,184,107,.5);opacity:0;transition:opacity .3s;}
.explore .nearby-line.on{opacity:1;}
.explore .nearby-line b{color:#ffb86b;font-size:12px;}
#scene-title{position:absolute;top:24px;left:50%;transform:translateX(-50%);z-index:5;
  font-size:12.5px;letter-spacing:.42em;color:#5fb8d4;
  text-shadow:0 0 14px rgba(77,208,225,.55);
  opacity:0;transition:opacity .8s;pointer-events:none;text-align:center;}
#scene-title.on{opacity:.85;}
#hint-move{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);z-index:5;
  font-size:10px;letter-spacing:.3em;color:#3d7f96;opacity:0;transition:opacity .8s;pointer-events:none;text-align:center;}
#hint-move.on{opacity:.7;}
#labels{position:absolute;inset:0;z-index:6;pointer-events:none;overflow:hidden;}
.hotspot-label{position:absolute;left:0;top:0;display:flex;align-items:center;gap:9px;transform:translate(-7px,-50%);
  opacity:0;transition:opacity .35s ease;pointer-events:auto;cursor:pointer;will-change:transform,opacity;}
.hotspot-label.on{opacity:1;}
.hotspot-label .dot{width:13px;height:13px;border-radius:50%;flex:0 0 auto;background:#4dd0e1;
  box-shadow:0 0 16px #4dd0e1,0 0 34px rgba(77,208,225,.55);position:relative;transition:transform .2s;}
.hotspot-label .dot::after{content:"";position:absolute;inset:-9px;border-radius:50%;
  border:1px solid rgba(77,208,225,.55);animation:ripple 2.2s ease-out infinite;}
@keyframes ripple{0%{transform:scale(.5);opacity:.9;}100%{transform:scale(2.2);opacity:0;}}
.hotspot-label .lbl{font-size:12.5px;letter-spacing:.16em;color:#a8dff0;background:rgba(6,18,34,.85);
  border:1px solid rgba(77,208,225,.24);border-radius:7px;padding:7px 13px;white-space:nowrap;
  transition:all .2s;backdrop-filter:blur(4px);}
.hotspot-label:hover .dot{transform:scale(1.35);}
.hotspot-label:hover .lbl{color:#fff;border-color:#4dd0e1;box-shadow:0 0 22px rgba(77,208,225,.5);background:rgba(10,32,52,.94);}
.hotspot-label.special .dot{background:#9fefff;box-shadow:0 0 22px #9fefff,0 0 44px rgba(159,239,255,.6);}
.hotspot-label.special .lbl{color:#cceeff;border-color:rgba(159,239,255,.5);background:rgba(6,26,44,.9);text-shadow:0 0 12px rgba(159,239,255,.7);}
.hotspot-label.special:hover .lbl{color:#fff;border-color:#9fefff;box-shadow:0 0 34px rgba(159,239,255,.8);background:rgba(6,32,54,.96);}
.item-label{position:absolute;left:0;top:0;display:flex;align-items:center;gap:7px;transform:translate(-6px,-50%);
  opacity:0;transition:opacity .35s ease;pointer-events:auto;cursor:pointer;will-change:transform,opacity;}
.item-label.on{opacity:.75;}
.item-label .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto;background:#ffb86b;
  box-shadow:0 0 12px #ffb86b;transition:transform .2s;}
.item-label .lbl{font-size:11px;letter-spacing:.14em;color:#ffd9a8;
  background:rgba(20,14,4,.8);border:1px solid rgba(255,184,107,.3);
  border-radius:6px;padding:5px 10px;white-space:nowrap;transition:all .2s;backdrop-filter:blur(4px);}
.item-label:hover .dot{transform:scale(1.5);}
.item-label:hover .lbl{color:#fff;border-color:#ffb86b;box-shadow:0 0 18px rgba(255,184,107,.5);}
.item-label.done{opacity:.28;}
.item-label.done .dot{background:#7a9cb0;box-shadow:0 0 8px rgba(122,156,176,.5);}
.item-label.interactive .dot{background:#7cf9ff;box-shadow:0 0 16px #7cf9ff,0 0 30px rgba(124,249,255,.5);}
.item-label.interactive .lbl{color:#cceeff;border-color:rgba(124,249,255,.4);background:rgba(6,26,44,.85);
  text-shadow:0 0 10px rgba(124,249,255,.6);font-weight:500;}
.item-label.interactive:hover .lbl{color:#fff;border-color:#7cf9ff;box-shadow:0 0 24px rgba(124,249,255,.7);background:rgba(6,32,54,.96);}
.abyss-light-label{position:absolute;left:0;top:0;display:flex;align-items:center;gap:8px;transform:translate(-50%,-50%);
  opacity:0;transition:opacity .5s;pointer-events:auto;cursor:pointer;will-change:transform,opacity;}
.abyss-light-label.on{opacity:1;}
.abyss-light-label .lbl{font-size:12px;letter-spacing:.18em;color:#9fefff;
  background:rgba(2,10,20,.85);border:1px solid rgba(159,239,255,.35);
  border-radius:6px;padding:6px 12px;white-space:nowrap;transition:all .22s;backdrop-filter:blur(4px);
  box-shadow:0 0 20px rgba(159,239,255,.25);}
.abyss-light-label:hover .lbl{color:#fff;border-color:#9fefff;box-shadow:0 0 30px rgba(159,239,255,.6);}
.abyss-light-label.lit .lbl{color:#c9a8ff;border-color:rgba(200,140,255,.5);background:rgba(15,4,28,.85);}
#text-panel{position:absolute;left:50%;bottom:44px;transform:translateX(-50%);width:min(880px,88vw);
  z-index:8;pointer-events:none;opacity:0;transition:opacity .4s;}
#text-panel.on{opacity:1;}
#text-box{position:relative;background:linear-gradient(160deg,rgba(6,18,34,.9),rgba(3,10,20,.94));
  border:1px solid rgba(77,208,225,.18);border-radius:14px;padding:24px 30px 28px;
  box-shadow:0 0 44px rgba(0,0,0,.75),inset 0 0 60px rgba(20,90,130,.08);
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);}
#text-box::before{content:"";position:absolute;left:0;top:14px;bottom:14px;width:2px;
  background:linear-gradient(180deg,transparent,#4dd0e1,transparent);opacity:.55;}
#speaker{font-size:11.5px;letter-spacing:.34em;color:#4dd0e1;opacity:.85;margin-bottom:10px;min-height:14px;
  text-shadow:0 0 12px rgba(77,208,225,.6);}
#text-content{font-size:clamp(15px,2.1vw,18px);line-height:1.95;letter-spacing:.03em;color:#d6ecf8;
  min-height:3.9em;text-shadow:0 0 22px rgba(120,200,230,.18);}
#text-content .hl{color:#7fe9ff;text-shadow:0 0 16px rgba(127,233,255,.7);}
#text-content .warn{color:#ff8a8a;text-shadow:0 0 16px rgba(255,110,110,.6);}
#text-content .dim{color:#7a9cb0;font-style:italic;}
#text-content .echo{color:#c9a8ff;text-shadow:0 0 20px rgba(200,140,255,.85);letter-spacing:.08em;}
#text-content .reveal{color:#fff;text-shadow:0 0 28px rgba(200,140,255,1),0 0 52px rgba(127,233,255,.7);
  letter-spacing:.16em;font-weight:500;}
#text-content .quote{color:#ffd9a8;font-style:italic;letter-spacing:.06em;
  text-shadow:0 0 18px rgba(255,184,107,.6);}
#text-content .whale{color:#9fefff;letter-spacing:.24em;font-weight:400;
  text-shadow:0 0 30px rgba(159,239,255,1),0 0 60px rgba(159,239,255,.6),0 0 100px rgba(100,200,255,.4);}
#text-hint{position:absolute;right:22px;bottom:13px;font-size:10.5px;letter-spacing:.3em;color:#4dd0e1;
  opacity:0;transition:opacity .3s;animation:pulse 1.6s ease-in-out infinite;}
#text-hint.on{opacity:.7;}
@keyframes pulse{0%,100%{opacity:.28;}50%{opacity:.85;}}
#choice-btns{position:absolute;right:26px;bottom:calc(44px + 160px);z-index:9;
  display:flex;flex-direction:column;gap:10px;opacity:0;pointer-events:none;
  transition:opacity .35s ease,transform .35s ease;transform:translateX(20px);}
#choice-btns.on{opacity:1;pointer-events:auto;transform:translateX(0);}
.c-btn{font-family:inherit;font-size:12px;letter-spacing:.4em;text-indent:.4em;
  color:#c8e4f5;background:rgba(6,18,34,.9);border:1px solid rgba(77,208,225,.35);
  border-radius:10px;padding:13px 26px;cursor:pointer;transition:all .22s;
  backdrop-filter:blur(6px);text-shadow:0 0 12px rgba(77,208,225,.5);
  box-shadow:0 0 22px rgba(0,0,0,.5);min-width:120px;text-align:center;}
.c-btn:hover{color:#fff;border-color:#4dd0e1;
  box-shadow:0 0 30px rgba(77,208,225,.6),0 0 60px rgba(77,208,225,.25);transform:translateY(-2px);}
.c-btn.respond:hover{border-color:#7cf9ff;box-shadow:0 0 30px rgba(124,249,255,.7),0 0 60px rgba(124,249,255,.3);}
.c-btn.silent:hover{border-color:#c9a8ff;box-shadow:0 0 30px rgba(200,140,255,.7),0 0 60px rgba(200,140,255,.3);}
.c-btn .hint-sub{display:block;font-size:9.5px;letter-spacing:.22em;color:#7a9cb0;margin-top:5px;text-shadow:none;opacity:.75;}
.c-btn.respond .hint-sub{color:#7cf9ff;opacity:.65;}
.c-btn.silent .hint-sub{color:#c9a8ff;opacity:.65;}
#scan-info{position:absolute;right:26px;top:50%;transform:translateY(-50%);
  width:min(340px,42vw);z-index:9;pointer-events:none;
  background:linear-gradient(150deg,rgba(30,20,6,.92),rgba(12,8,4,.94));
  border:1px solid rgba(255,184,107,.35);border-left:3px solid #ffb86b;
  border-radius:10px;padding:16px 20px;opacity:0;transition:opacity .4s,transform .4s;
  box-shadow:0 0 30px rgba(0,0,0,.7);}
#scan-info.on{opacity:1;transform:translateY(-50%) translateX(0);}
#scan-info .title{font-size:11px;letter-spacing:.3em;color:#ffb86b;
  text-shadow:0 0 12px rgba(255,184,107,.6);margin-bottom:9px;}
#scan-info .body{font-size:13px;line-height:1.75;color:#ffd9a8;letter-spacing:.02em;}
#radio-hud{position:absolute;right:26px;top:calc(50% + 120px);z-index:9;pointer-events:none;
  background:linear-gradient(150deg,rgba(6,26,44,.9),rgba(3,14,26,.94));
  border:1px solid rgba(124,249,255,.35);border-left:3px solid #7cf9ff;
  border-radius:8px;padding:10px 16px;opacity:0;transition:opacity .4s;
  box-shadow:0 0 24px rgba(0,0,0,.7);}
#radio-hud.on{opacity:1;}
#radio-hud .rh-label{font-size:9px;letter-spacing:.34em;color:#7cf9ff;opacity:.7;}
#radio-hud .rh-freq{font-size:20px;font-weight:500;color:#fff;letter-spacing:.06em;
  text-shadow:0 0 16px rgba(124,249,255,.8);font-variant-numeric:tabular-nums;margin-top:4px;}
#radio-hud .rh-freq.tuned{color:#7cf9ff;animation:rhGlow 1s ease-in-out infinite;}
@keyframes rhGlow{0%,100%{opacity:.9;}50%{opacity:1;text-shadow:0 0 24px rgba(124,249,255,1),0 0 48px rgba(124,249,255,.6);}}
.whisper{position:absolute;z-index:7;pointer-events:none;
  font-size:clamp(16px,2.4vw,22px);font-weight:300;color:#c9a8ff;letter-spacing:.32em;
  text-shadow:0 0 24px rgba(200,140,255,.9),0 0 48px rgba(200,140,255,.5);
  animation:whisperIn 2.4s ease-out forwards;white-space:nowrap;}
@keyframes whisperIn{0%{opacity:0;transform:translateY(8px) scale(.94);filter:blur(4px);}
  18%{opacity:.85;filter:blur(0);transform:none;}
  72%{opacity:.85;}
  100%{opacity:0;transform:translateY(-6px);filter:blur(2px);}}
#top-btns{position:absolute;top:24px;right:28px;z-index:9;display:flex;gap:10px;align-items:center;
  opacity:0;transition:opacity .6s;pointer-events:none;flex-wrap:wrap;justify-content:flex-end;}
#top-btns.on{opacity:1;pointer-events:auto;}
.icon-btn{display:flex;align-items:center;gap:9px;cursor:pointer;}
.icon-btn .cnt{font-size:11px;letter-spacing:.26em;color:#4dd0e1;background:rgba(6,18,34,.85);
  border:1px solid rgba(77,208,225,.3);border-radius:7px;padding:7px 13px;transition:all .22s;}
.icon-btn:hover .cnt{color:#fff;border-color:#4dd0e1;box-shadow:0 0 22px rgba(77,208,225,.5);}
.icon-btn .ico{width:11px;height:11px;border-radius:50%;background:#4dd0e1;
  box-shadow:0 0 14px #4dd0e1;animation:pulse 2.4s ease-in-out infinite;}
.icon-btn.backlog .ico{background:#ffb86b;box-shadow:0 0 14px #ffb86b;}
#lang-btn{cursor:pointer;}
#lang-btn .cnt{font-size:11px;letter-spacing:.26em;color:#ffd166;background:rgba(30,20,6,.85);
  border:1px solid rgba(255,209,102,.4);border-radius:7px;padding:7px 13px;transition:all .22s;}
#lang-btn:hover .cnt{color:#fff;border-color:#ffd166;box-shadow:0 0 22px rgba(255,209,102,.6);background:rgba(40,28,6,.95);}
#notebook-btn{position:absolute;right:28px;bottom:24px;z-index:9;
  display:flex;align-items:center;gap:9px;cursor:pointer;
  opacity:0;transition:opacity .6s,transform .2s;pointer-events:none;}
#notebook-btn.on{opacity:1;pointer-events:auto;}
#notebook-btn:hover{transform:translateY(-2px);}
#notebook-btn .ico{width:11px;height:11px;border-radius:2px;background:#ffd166;box-shadow:0 0 14px #ffd166;}
#notebook-btn .cnt{font-size:11px;letter-spacing:.26em;color:#ffd166;
  background:rgba(20,14,4,.85);border:1px solid rgba(255,209,102,.4);
  border-radius:7px;padding:7px 13px;transition:all .22s;}
#notebook-btn:hover .cnt{color:#fff;border-color:#ffd166;box-shadow:0 0 22px rgba(255,209,102,.6);background:rgba(40,28,6,.95);}
#notebook-btn.has-notes .ico{animation:notePulse 2s ease-in-out infinite;}
@keyframes notePulse{0%,100%{box-shadow:0 0 14px #ffd166;}50%{box-shadow:0 0 28px #ffd166,0 0 48px rgba(255,209,102,.5);}}
/* ★ 地图 */
#minimap{position:absolute;top:76px;right:28px;z-index:9;
  width:200px;height:150px;pointer-events:none;
  background:rgba(2,10,20,.75);border:1px solid rgba(77,208,225,.25);
  border-radius:10px;opacity:0;transition:opacity .6s;
  backdrop-filter:blur(6px);padding:8px;}
#minimap.on{opacity:.85;}
#minimap svg{width:100%;height:100%;display:block;}
.mini-room{fill:rgba(8,20,34,.9);stroke:rgba(122,156,176,.3);stroke-width:0.8;
  transition:fill .3s,stroke .3s;}
.mini-room.visited{fill:rgba(15,45,70,.95);stroke:rgba(77,208,225,.5);}
.mini-room.current{fill:rgba(34,230,255,.25);stroke:#4dd0e1;stroke-width:1.5;
  animation:miniPulse 1.8s ease-in-out infinite;}
