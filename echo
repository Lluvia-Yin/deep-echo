function breathSfx() {
  if (!AC) return;
  try {
    const bs = AC.sampleRate * 0.8;
    const buf = AC.createBuffer(1, bs, AC.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bs; i++) {
      const t = i / bs;
      const env = Math.exp(-Math.pow((t - 0.3) * 4, 2));
      data[i] = (Math.random() * 2 - 1) * env * 0.5;
    }
    const src = AC.createBufferSource();
    src.buffer = buf;
    const flt = AC.createBiquadFilter();
    flt.type = 'bandpass'; flt.frequency.value = 800; flt.Q.value = 1.2;
    const g = AC.createGain(); g.gain.value = 0.04;
    src.connect(flt); flt.connect(g); g.connect(AC.destination);
    src.start();
  } catch (e) {}
}
