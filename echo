  scene.fog = new THREE.FogExp2(0x030a14, 0.038);
  camera = new THREE.PerspectiveCamera(64, W() / H(), 0.1, 300);
  camera.position.set(0, 1.7, 6);
  initPostProcessing();
}

function initPostProcessing() {
  if (typeof THREE.EffectComposer === 'undefined') return;
  try {
    composer = new THREE.EffectComposer(renderer);
    composer.setSize(W(), H());
    const renderPass = new THREE.RenderPass(scene, camera);
    composer.addPass(renderPass);

    bloomPass = new THREE.UnrealBloomPass(
      new THREE.Vector2(W(), H()),
      0.55,   // strength
      0.5,    // radius
      0.85    // threshold
    );
    composer.addPass(bloomPass);

    if (THREE.FilmPass) {
      filmPass = new THREE.FilmPass(0.18, 0.6, 648, false);
      composer.addPass(filmPass);
    }

    // 色差 + 共鸣色彩分级 shader
    const chromaticShader = {
      uniforms: {
        tDiffuse: { value: null },
        uIntensity: { value: 0.0018 },
        uEcho: { value: 0.0 }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform sampler2D tDiffuse;
        uniform float uIntensity;
        uniform float uEcho;
        varying vec2 vUv;
        void main() {
          vec2 dir = vUv - 0.5;
          float d = length(dir);
          // 色差随共鸣增强
          float ab = uIntensity * (1.0 + uEcho * 1.6);
          float r = texture2D(tDiffuse, vUv - dir * ab * d).r;
          float g = texture2D(tDiffuse, vUv).g;
          float b = texture2D(tDiffuse, vUv + dir * ab * d).b;
          vec3 col = vec3(r, g, b);
          // 共鸣越高越去饱和，越不像"人眼所见"
          float lum = dot(col, vec3(0.299, 0.587, 0.114));
          col = mix(col, vec3(lum), uEcho * 0.35);
          // 中心品红偏移
          float c = 1.0 - d;
          col.r += uEcho * 0.10 * c;
          col.b += uEcho * 0.06 * c;
          // 边缘红移 + 暗角
          float edge = smoothstep(0.35, 0.95, d);
          col = mix(col, col * vec3(1.25, 0.72, 0.78), edge * uEcho * 0.7);
          col *= 1.0 - edge * uEcho * 0.28;
          gl_FragColor = vec4(col, 1.0);
        }
      `
    };
    chromaticPass = new THREE.ShaderPass(chromaticShader);
    chromaticPass.renderToScreen = true;
    composer.addPass(chromaticPass);
  } catch (e) {
    console.warn('[ECHO] 后处理初始化失败：', e);
    composer = null;
  }
}

