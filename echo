let lastTime = performance.now();
function loop(now) {
  requestAnimationFrame(loop);
  let dt = (now - lastTime) / 1000;
  lastTime = now;
  // 页面不可见时不更新、不渲染（同时暂停氧气消耗）
  if (document.hidden) return;
  if (dt > 0.05) dt = 0.05;
  if (dt < 0) dt = 0;
  S.time += dt; sceneTime += dt;
  // 共鸣色彩分级：平滑跟随，避免数值跳变导致画面骤变
  _gradeEcho += (clamp(S.echo / 100, 0, 1) - _gradeEcho) * Math.min(1, dt * 1.5);
  if (chromaticPass) chromaticPass.uniforms.uEcho.value = _gradeEcho;
  // 雾气随共鸣加深（深渊固定，避免遮挡核心演出）
  if (scene.fog && !_fogBase.fixed) scene.fog.density = _fogBase.density * (1 + _gradeEcho * 0.45);
  // 光束缓慢呼吸
  for (let i = 0; i < SHAFTS.length; i++) {
    const sh = SHAFTS[i];
    sh.material.opacity = sh.userData.baseOpacity * (0.82 + 0.18 * Math.sin(S.time * 0.6 + sh.userData.ph));
  }
  const sa = updateScriptedCamera(dt);
  if (S.state === 'playing' && !sa) {
    updateTyping(dt);
    updateResources(dt);
    updateTimedChoice(dt);
  } else updateBodyFeel(dt);
  if (!sa) updatePlayerMove(dt);
  if (currentSceneData) {
    if (currentSceneData.update) currentSceneData.update(dt, sceneTime);
    if (currentSceneData.dust) updateDust(currentSceneData.dust, dt);
  }
  updateAbyssParticles(dt);
  if (hotspotMarkers.length > 0) updateHotspotMarkers(dt, sceneTime);
  if (itemMarkers.length > 0) updateItemMarkers(dt, sceneTime);
  if (S.abyssMode && ABYSS_LIGHTS.length > 0) updateAbyssLightLabels();
  // 后处理渲染
  if (renderer && scene && camera) {
    if (composer) {
      composer.render();
    } else {
      renderer.render(scene, camera);
    }
  }
  if (AC && S.state === 'playing') updateListener();
}

